NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/themisdb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/themisdb?sslmode=require

JWT_SECRET=cambiar-por-un-secreto-de-al-menos-16-caracteres

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=cambiar-por-el-mismo-valor-que-SERVICE_TOKEN-en-themis-ai
AI_SERVICE_TIMEOUT_MS=5000

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CONTRACT_ADDRESS=
SEMAPHORE_REGISTRY_ADDRESS=
# Bloque de despliegue del registro (en local da igual, 0).
CHAIN_START_BLOCK=0
# Explorador de bloques para los links de la auditoria (vacio en local).
EXPLORER_URL=

# Solo para desplegar en Base Sepolia (pnpm chain:deploy:semaphore:base-sepolia).
# Wallet propia con ETH de faucet. En EC2 esta misma clave va como RELAYER_PRIVATE_KEY
# (el backend no arranca con la clave de Hardhat de arriba si CHAIN_ID != 31337).
BASE_SEPOLIA_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=

SSO_MOCK_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
SSO_MOCK_TOKEN_TTL_SECONDS=3600

# Generar con: pnpm registration:generate-signing-key (imprime ambos valores)
REGISTRATION_SIGNING_PRIVATE_KEY_JWK=
REGISTRATION_SIGNING_PUBLIC_KEY_JWK=
